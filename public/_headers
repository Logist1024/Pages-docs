# Workers 静态资源缓存策略（_headers 由 Wrangler 识别）
# 入口文件使用稳定文件名（无 hash），必须可协商刷新；
# 带 hash 的动态 chunk（如 mermaid）可永久缓存。
/admin.html
  Cache-Control: public, max-age=300, must-revalidate

/assets/read.js
  Cache-Control: public, max-age=300, must-revalidate
/assets/read.css
  Cache-Control: public, max-age=300, must-revalidate
/assets/admin.js
  Cache-Control: public, max-age=300, must-revalidate

/assets/*-*.js
  Cache-Control: public, max-age=31536000, immutable
